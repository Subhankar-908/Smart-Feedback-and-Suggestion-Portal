# Copy to .env and change all secrets before deployment.
# Local SQLite database (default): sqlite:///./smart_feedback.db
DATABASE_URL=sqlite:///./smart_feedback.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# First-run admin account. Change the password immediately after setup.
ADMIN_EMAIL=admin@123.com
ADMIN_PASSWORD=no pass


# Set true only for a local demo; adds sample students and feedback.
SEED_DEMO_DATA=false
